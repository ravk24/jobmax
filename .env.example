# Copy to .env.local and fill in. .env* is gitignored.

# --- Required to run the app today -----------------------------------------

# InsForge backend — auth, database, storage.
# Both from the InsForge dashboard: Install -> API Keys.
NEXT_PUBLIC_INSFORGE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# PostHog — analytics. Project settings -> Project API Key.
# Outside development the app skips init rather than throwing, so a missing
# key means silently zero events. Set this in every deployment environment.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Not used yet — required by features still to be built ------------------

# Adzuna job discovery (Feature 10)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# GPT-4o — resume extraction, job matching, research synthesis
# (Features 07, 08, 10, 13)
OPENAI_API_KEY=

# Browserbase + Stagehand — company research agent (Feature 13)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
